*.gpg           binary

# ------------------------------------------------------------------------------
# 8. Git Archive Export Exclusions (`git archive` / Release Tarballs)
# ------------------------------------------------------------------------------
.editorconfig     export-ignore
.gitattributes    export-ignore
.github           export-ignore
.gitignore        export-ignore
eslint.config.js  export-ignore
test              export-ignore
